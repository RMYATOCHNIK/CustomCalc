<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CustomCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="colorPrimary">@color/primary_accent</item>
    </style>

    <style name="Theme.CustomCalculator" parent="Base.Theme.CustomCalculator" />

    <style name="CalcButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Calculator.Button</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="ShapeAppearance.Calculator.Button" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Calculator.KeyboardTopOnly" parent="">
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="CalcButton.Number">
        <item name="backgroundTint">@color/btn_num_bg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="backgroundTint">@color/operator_accent</item>
        <item name="android:textColor">@color/bg_main</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcButton.Function">
        <item name="backgroundTint">@color/btn_func_bg</item>
        <item name="android:textColor">@color/primary_accent</item>
    </style>

    <style name="CalcButton.Equal">
        <item name="backgroundTint">@color/equal_accent</item>
        <item name="android:textColor">@color/bg_main</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>